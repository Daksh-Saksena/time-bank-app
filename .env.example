# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Daily.co Video Assistance
# Note: In production (Vercel), set DAILY_API_KEY as a serverless environment variable
VITE_DAILY_API_KEY=your-daily-api-key
VITE_DAILY_DOMAIN=your-subdomain.daily.co

# Firebase & Push Notifications
VITE_FIREBASE_VAPID_KEY=your-firebase-vapid-key
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
